{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qjcyoccdquidylaufinc.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gene-annotator",
      "version": "0.1.0",
      "title": "Gene Annotator"
    },
    "tools": [
      {
        "name": "lookup_gene",
        "title": "Look up gene annotations",
        "description": "Fetch human gene metadata, CIViC evidence and complete DGIdb drug lists, with explicit source availability and alias resolution.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "pattern": "^(?=.*[A-Za-z])[A-Za-z0-9._-]{1,40}$",
              "description": "HGNC gene symbol, e.g. TP53, BRCA1, EGFR."
            }
          },
          "required": [
            "symbol"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "lookup_genes_batch",
        "title": "Look up multiple genes (compact)",
        "description": "Return compact human gene evidence and distinct drug counts for up to 40 input rows, preserving duplicates and reporting unavailable sources.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "symbols": {
              "minItems": 1,
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?=.*[A-Za-z])[A-Za-z0-9._-]{1,40}$"
              },
              "description": "Up to 40 HGNC gene symbols."
            }
          },
          "required": [
            "symbols"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
